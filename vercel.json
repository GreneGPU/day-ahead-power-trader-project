{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,notebooks/**,scripts/**,data/**,outputs/**,reports/**,src/intraday_power_quant/streamlit_app.py}",
      "includeFiles": "public/strategy-presets.json"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/cv",
      "destination": "/?utm_source=cv&utm_medium=pdf&utm_campaign=cv",
      "permanent": false
    },
    {
      "source": "/cv/:campaign",
      "destination": "/?utm_source=cv&utm_medium=pdf&utm_campaign=:campaign",
      "permanent": false
    }
  ]
}
